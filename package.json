{
  "name": "pfeils-catering-web",
  "description": "Website of Pfeil's Cocktail Catering.",
  "cloudflare": {
    "label": "Astro Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
    "publish": true
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.0.1",
    "@astrojs/mdx": "7.0.0",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.21.0",
    "@tailwindcss/vite": "4.3.1",
    "astro": "7.0.3",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "lighthouse": "13.4.0",
    "wrangler": "4.105.0"
  },
  "private": true,
  "overrides": {
    "vite": "8.1.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "cf-typegen": "wrangler types",
    "check": "astro build && tsc && wrangler deploy --dry-run",
    "deploy:dev": "CLOUDFLARE_ENV=dev astro build && wrangler deploy --env dev",
    "deploy:prod": "CLOUDFLARE_ENV=prod astro build && wrangler deploy --env prod",
    "dev": "astro dev --host",
    "lighthouse:local": "node ./scripts/lighthouse-all.js --sitemap http://localhost:4321/sitemap-index.xml --target-origin http://localhost:4321 --output-dir .lighthouse/local",
    "lighthouse:prod": "node ./scripts/lighthouse-all.js --sitemap https://www.pfeils-catering.de/sitemap-index.xml --target-origin https://www.pfeils-catering.de --output-dir .lighthouse/prod",
    "preview": "astro build && astro preview"
  },
  "type": "module"
}
