---
/**
 * HeroMain: Full-viewport homepage hero.
 * Background comes from imageProvider; copy from i18n (`hero.*`).
 * Do not reuse on service subpages — those use HeroSubpage.
 */
import { Image } from "astro:assets";
import { getImageAlt } from "../../utils/imageUtils";
import { imageProvider } from "../../provider/imageProvider";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const heroImageAsset = imageProvider.hero.headerBackground;
const heroImage = imageProvider.hero.headerBackground.src as import("astro").ImageMetadata;
---

{/* HeroMain: full-bleed bar photo, centered title, scroll hint */}
<section
  id="hero-main"
  class="relative flex min-h-screen items-center justify-center overflow-hidden bg-dark-bg"
>
  {/* LCP image: eager + high priority, not a CSS background */}
  <Image
    src={heroImage}
    alt={getImageAlt(heroImageAsset, lang)}
    class="hero-bg-image absolute inset-0 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    format="webp"
    height={heroImage.height}
    quality={80}
    sizes="100vw"
    width={heroImage.width}
    widths={[640, 960, 1280, 1600, 1920, 2400]}
  />

  {/* Overlays: keep the photo visible, text readable, edges darkened */}
  <div class="absolute inset-0 bg-black/20"></div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-dark-bg via-dark-bg/20 to-black/45"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgb(0_9_22_/_0.55)_100%)]"
  >
  </div>

  {/* Copy: eyebrow, title, subtitle — all from translations */}
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center px-6 pt-28 pb-24 text-center md:px-12 md:pt-32 min-[1920px]:max-w-8xl"
  >
    <p
      class="hero-reveal mb-5 font-outfit text-xs font-medium uppercase tracking-[0.42em] text-white/70 md:mb-6 md:text-sm min-[1920px]:mb-8 min-[1920px]:text-base"
    >
      {t("hero.eyebrow")}
    </p>

    <h1
      class="hero-title hero-reveal hero-reveal-delay-1 mb-5 w-full text-balance font-anton font-medium leading-[1.05] text-white md:mb-6 min-[1920px]:mb-8"
    >
      {t("hero.title")}
    </h1>

    <p
      class="hero-subtitle hero-reveal hero-reveal-delay-2 max-w-2xl text-pretty font-outfit font-light leading-relaxed text-white/80"
    >
      {t("hero.subtitle")}
    </p>
  </div>

  {/* Scroll hint: jumps to the next <section> (see script below) */}
  <button
    type="button"
    class="hero-reveal hero-reveal-delay-3 absolute bottom-8 left-1/2 z-10 -translate-x-1/2 cursor-pointer border-none bg-transparent p-0 text-white/50 transition-opacity hover:text-white/80"
    aria-label={t("hero.scrollLabel")}
    data-scroll-to-next
  >
    <span class="hero-scroll-chevron block text-2xl leading-none" aria-hidden="true">
      ⌄
    </span>
  </button>
</section>

<style>
  /* Title: 56px on phones, fluid in between, 128px cap on large screens.
     Keep this in CSS — stacked Tailwind text-* utilities override each other. */
  .hero-title {
    font-size: clamp(3.5rem, 5.5vw + 0.75rem, 128px);
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 0.85rem + 0.8vw, 1.5rem);
  }

  /* Entrance: blur + rise. Delays stagger eyebrow → title → subtitle → chevron. */
  .hero-reveal {
    animation: heroReveal 1.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-reveal-delay-1 {
    animation-delay: 0.18s;
  }

  .hero-reveal-delay-2 {
    animation-delay: 0.38s;
  }

  .hero-reveal-delay-3 {
    animation-delay: 0.75s;
  }

  .hero-bg-image {
    animation: heroKenBurns 28s ease-out forwards;
  }

  .hero-scroll-chevron {
    animation: mouseScroll 2.8s ease-in-out infinite;
  }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes heroKenBurns {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.05);
    }
  }

  @keyframes mouseScroll {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }

    50% {
      transform: translateY(6px);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-bg-image,
    .hero-scroll-chevron {
      animation: none;
    }
  }
</style>

<script is:inline>
  /*
   * Scroll to the next section when the chevron (or any [data-scroll-to-next]) is clicked.
   * is:inline = runs in the page, not bundled by Astro.
   */
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-scroll-to-next]").forEach((scrollButton) => {
      scrollButton.addEventListener("click", () => {
        const hero = document.getElementById("hero-main");
        if (!hero) return;

        let next = hero.nextElementSibling;
        while (next && next.tagName !== "SECTION") {
          next = next.nextElementSibling;
        }

        if (next) {
          next.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  });
</script>
