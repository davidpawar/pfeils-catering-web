---
/**
 * HeroSubpage: Compact hero for subpages – like HeroMain but smaller height & text.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ImageAsset } from "../../provider/imageProvider";
import { getImageAlt } from "../../provider/imageProvider";
import { getLangFromUrl } from "../../i18n/utils";

interface Props {
  /**
   * Optional hero image from imageProvider. Rendered as <img> (not CSS background)
   * so LCP is discoverable and fetchpriority applies.
   */
  image?: ImageAsset;
  /**
   * Main heading.
   */
  title: string;
}

const lang = getLangFromUrl(Astro.url);
const { image, title } = Astro.props;

const heroSrc = image?.src;
const hasHeroImage = !!heroSrc;
const heroMetadata =
  typeof heroSrc === "object" ? (heroSrc as ImageMetadata) : undefined;
const heroWidth = heroMetadata?.width ?? 1920;
const heroHeight = heroMetadata?.height ?? 1080;
---

{/* HeroSubpage: Compact hero for subpages – like HeroMain but smaller height & text */}
<section
  class="relative flex min-h-[45vh] flex-col justify-center overflow-hidden bg-dark-bg md:min-h-[55vh]"
>
  {
    hasHeroImage && image && (
      <Image
        src={heroSrc as ImageMetadata}
        alt={getImageAlt(image, lang)}
        class="absolute inset-0 h-full w-full object-cover object-center"
        fetchpriority="high"
        format="webp"
        height={heroHeight}
        loading="eager"
        quality={80}
        sizes="100vw"
        width={heroWidth}
        widths={[640, 960, 1280, 1600, 1920, 2400]}
      />
    )
  }

  {
    hasHeroImage && (
      <div class="absolute inset-0 bg-gradient-to-r from-black/67 to-black/32 opacity-75" />
    )
  }

  {/* Content container */}
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col justify-center px-6 py-12 md:px-12 md:py-16 lg:px-16 lg:py-20 min-[1920px]:max-w-8xl"
  >
    <div class="max-w-3xl">
      {/* Title: main heading – smaller than HeroMain */}
      <h1
        class="font-anton text-2xl font-medium leading-tight text-white md:text-3xl lg:text-4xl xl:text-5xl"
      >
        {title}
      </h1>
    </div>
  </div>
</section>
