---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import { render } from "astro:content";
import { getLangFromUrl } from "../../../i18n/utils";

/**
 * One route per EN article, from the blogEn collection.
 *
 * The collection id carries the language folder, so "en/foo" becomes the
 * slug "foo".
 */
export async function getStaticPaths() {
  const posts = await getCollection("blogEn");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^en\//, "") },
    props: post,
  }));
}
type Props = CollectionEntry<"blogEn">;

const post = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { Content } = await render(post);
---

<BlogPost {...post.data} lang={lang}>
  <Content />
</BlogPost>
